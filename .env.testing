# ==========================================
# .env.testing — базовые значения для CI/тестов
# Секреты переопределяются в test-compose.yml через env-блок
# ==========================================

# === Versions ===
GATEWAY_VERSION=latest
AUTH_VERSION=latest
CRATE_VERSION=latest
MARKETPLACE_VERSION=latest
ECONOMY_VERSION=latest
RELAY_VERSION=latest
PREVIEW_VERSION=latest
LOGISTICS_VERSION=latest

# === Environment ===
NODE_ENV=test
ENVIRONMENT=testing
LOG_LEVEL=INFO

# === Database ===
DB_PASSWORD=ci_test_password
POSTGRES_DB=crate_digger

# === Redis ===
REDIS_PASSWORD=ci_test_password
REDIS_EVENT_CHANNEL=preview:trigger

# === MinIO / S3 ===
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=test-bucket
S3_ENDPOINT_URL=http://minio:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# аудио играет браузер через nginx;
# marketplace/crate-digger переопределяют на http://minio:9000 в compose
MINIO_PUBLIC_URL=/minio
SOURCE_BUCKET=test-bucket
PREVIEW_BUCKET=ytb-audio-previews
LISTING_BUCKET=listing-audio
LISTINGS_BUCKET=marketplace-listings

# === Внутренние URL сервисов (сеть compose) ===
AUTH_SERVICE_URL=http://auth-service:8000
ECONOMY_SERVICE_URL=http://economy-service:8000
CRATE_SERVICE_URL=http://crate-digger:8000
CATALOG_SERVICE_URL=http://crate-digger:8000
MARKETPLACE_SERVICE_URL=http://marketplace-service:8003
REVIEW_SERVICE_URL=http://review-service:8000
RELAY_SERVICE_URL=http://relay-api:8000
PREVIEW_SERVICE_URL=http://preview-api:8000
LOGISTICS_SERVICE_URL=http://logistics-service:8004

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost
FRONTEND_URL=http://localhost:3000

# === Gateway ===
GATEWAY_PORT=80
HTTP_TIMEOUT=30.0
RATE_LIMIT_DEFAULT=1000/minute
RATE_LIMIT_AUTH=100/minute
RATE_LIMIT_PUBLIC=30/minute
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60
CACHE_TTL_RELEASES=3600
CACHE_TTL_SELLERS=60
CACHE_TTL_USERS=300

# === Auth Service ===
JWT_SECRET_KEY=ci_test_jwt_secret_key
JWT_ALGORITHM=HS256
UNISENDER_API_KEY=ci_test_unisender_api_key
UNISENDER_LIST_ID=ci_test_unisender_list_id
EMAIL_BACKEND=unisender
INITIAL_ADMIN_EMAIL=admin@crate.market

# === Economy Service ===
PLATFORM_FEE_PERCENTAGE=0.10
YOOKASSA_SHOP_ID=ci_test_yookassa_shop_id
YOOKASSA_SECRET_KEY=ci_test_yookassa_secret_key
YOOKASSA_RETURN_URL=http://localhost:3000/checkout/result
YOOKASSA_TEST_MODE=true

# === Crate Digger ===
DISCOGS_TOKEN=ci_test_discogs_token
AUDIO_DOWNLOAD_TIMEOUT=600
AUDIO_POLL_INTERVAL=5

# === Telegram (relay) ===
API_ID=12345678
API_HASH=ci_test_api_hash
PHONE=+1234567890
SESSION_NAME=/app/sessions/ytb_session

# === Marketplace: бизнес-лимиты ===
MIN_PRICE=1.0
MAX_PRICE=1000000.0
MAX_COVER_SIZE_MB=10
MAX_PHOTOS_COUNT=5

# === Внутренний токен межсервисного взаимодействия ===
INTERNAL_SERVICE_TOKEN=ci_test_internal_service_token

# === GHCR (только для CI-логина; сервисы не читают) ===
GHCR_USERNAME=ci-placeholder
GHCR_PASSWORD=ci-placeholder