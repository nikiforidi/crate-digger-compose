# ==========================================
# .env.stage — Stage-окружение (stage.waxey.ru)
# Секреты заменяются на сервере вручную
# Версии обновляются автоматически при деплое
# ==========================================

# === Версии образов (обновляются автоматически при деплое) ===
GATEWAY_VERSION=latest
AUTH_VERSION=latest
CRATE_VERSION=latest
MARKETPLACE_VERSION=latest
ECONOMY_VERSION=latest
REVIEW_VERSION=latest
LOGISTICS_VERSION=latest
RELAY_VERSION=latest
PREVIEW_VERSION=latest
FRONTEND_VERSION=latest

# === Gateway ===
GATEWAY_PORT=80

# === Environment ===
NODE_ENV=production
ENVIRONMENT=staging
LOG_LEVEL=INFO

# === Database ===
DB_PASSWORD=CHANGE_ME_STAGE_DB_PASSWORD
POSTGRES_DB=crate_digger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STAGE_DB_PASSWORD

# === Redis ===
REDIS_PASSWORD=CHANGE_ME_STAGE_REDIS_PASSWORD

# === MinIO / S3 ===
S3_ACCESS_KEY=CHANGE_ME_STAGE_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_STAGE_S3_SECRET_KEY
S3_BUCKET_NAME=waxey-stage-bucket
S3_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_URL=/minio

# === Auth Service ===
JWT_SECRET_KEY=CHANGE_ME_STAGE_JWT_SECRET
UNISENDER_API_KEY=CHANGE_ME_STAGE_UNISENDER_KEY
UNISENDER_LIST_ID=CHANGE_ME_STAGE_UNISENDER_LIST_ID
FRONTEND_URL=https://stage.waxey.ru
EMAIL_BACKEND=unisender
INITIAL_ADMIN_EMAIL=admin@crate.market
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STAGE_ADMIN_PASSWORD

# === Economy Service ===
PLATFORM_FEE_PERCENTAGE=0.10
YOOKASSA_SHOP_ID=CHANGE_ME_STAGE_YOOKASSA_SHOP_ID
YOOKASSA_SECRET_KEY=CHANGE_ME_STAGE_YOOKASSA_SECRET_KEY
YOOKASSA_RETURN_URL=https://stage.waxey.ru/checkout/result
YOOKASSA_TEST_MODE=true
CATALOG_SERVICE_URL=http://crate-digger:8000
AUTH_SERVICE_URL=http://auth-service:8000

# === Crate Digger ===
DISCOGS_TOKEN=CHANGE_ME_STAGE_DISCOGS_TOKEN

# === Logistics / ApiShip ===
LOGISTICS_SERVICE_URL=http://logistics-service:8004
APISHIP_BASE_URL=https://api.apiship.ru/v1
APISHIP_TOKEN=CHANGE_ME_STAGE_APISHIP_TOKEN
APISHIP_TEST_MODE=true
APISHIP_WEBHOOK_URL=https://stage.waxey.ru/api/v1/shipping/webhooks/apiship
COURIER_PICKUP_FEE_RUB=150
DEFAULT_WEIGHT_G=600
DEFAULT_SIZE_CM=30

# === Gateway Settings ===
HTTP_TIMEOUT=30.0
RATE_LIMIT_DEFAULT=1000/minute
RATE_LIMIT_AUTH=100/minute
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60
CACHE_TTL_RELEASES=3600
CACHE_TTL_SELLERS=60
CACHE_TTL_USERS=300

# === Telegram (Audio Relay) ===
API_ID=CHANGE_ME_STAGE_TG_API_ID
API_HASH=CHANGE_ME_STAGE_TG_API_HASH
PHONE=CHANGE_ME_STAGE_TG_PHONE
SESSION_NAME=/app/sessions/ytb_session.session

# === Preview Service ===
REDIS_EVENT_CHANNEL=preview:trigger

# === Межсервисный токен ===
INTERNAL_SERVICE_TOKEN=CHANGE_ME_STAGE_INTERNAL_TOKEN
CATALOG_CLIENT_TIMEOUT=5.0

# === Frontend ===
NEXT_PUBLIC_API_URL=https://stage.waxey.ru
NEXT_IMAGE_BASE_URL=https://stage.waxey.ru