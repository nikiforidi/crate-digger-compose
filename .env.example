# ==========================================
# Crate Digger Compose — пример окружения
# Скопируй в .env и заполни реальные значения:
#   cp .env.example .env
# ==========================================

# ── Окружение ──
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Инфраструктура ──
# Пароль postgres (используется всеми сервисами и db-init)
DB_PASSWORD=dev_db_password
# Пароль redis (общий для всех сервисов)
REDIS_PASSWORD=dev_redis_password

# ── S3 / MinIO ──
# Эти же значения становятся MINIO_ROOT_USER / MINIO_ROOT_PASSWORD у minio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniosecret123
S3_BUCKET_NAME=ytb-audio
S3_ENDPOINT_URL=http://minio:9000

# ── JWT ──
# 🔑 ДОЛЖЕН СОВПАДАТЬ во всех сервисах (gateway, auth, marketplace,
# economy, review) — иначе gateway не валидирует токены
JWT_SECRET_KEY=super_secret_dev_key_change_in_prod

# Токен межсервисного взаимодействия (economy → marketplace)
INTERNAL_SERVICE_TOKEN=super_secret_internal_token_change_in_prod

# ── Порты на хосте ──
GATEWAY_PORT=80
FRONTEND_PORT=3000

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost

# ── Auth Service ──
UNISENDER_API_KEY=
UNISENDER_LIST_ID=
EMAIL_BACKEND=unisender
FRONTEND_URL=http://localhost
INITIAL_ADMIN_EMAIL=admin@example.com

# ── Crate Digger (Discogs) ──
DISCOGS_TOKEN=

# ── Economy (ЮKassa) ──
PLATFORM_FEE_PERCENTAGE=0.10
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost/checkout/result
YOOKASSA_TEST_MODE=true

# ── Telegram (ytb-audio-relay) ──
API_ID=123456
API_HASH=dummy
PHONE=+10000000000